# Connected App Consumer Key (no secret needed — PKCE public client, see design doc Section 8)
SF_CLIENT_ID=

# Base login URL for the org you're authenticating against.
# Production/Dev Edition: https://login.salesforce.com
# Sandbox:                https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# Must exactly match the Callback URL configured on the Connected App
SF_CALLBACK_URL=http://localhost:3000/oauth/callback

# Local service port
PORT=3000

# Session secret — local/dev only, nothing persisted between visits regardless
SESSION_SECRET=change-me-local-dev-only

# LLM provider is deferred (design doc Section 6) — leave blank to use the
# deterministic fallback test-case generator. Fill in once a provider is chosen.
LLM_PROVIDER=
LLM_API_KEY=

# Debug aid — set to false to watch the actual Playwright browser live
# during a test run instead of only reviewing screenshots afterward.
# Defaults to true (headless) otherwise.
PLAYWRIGHT_HEADLESS=true
