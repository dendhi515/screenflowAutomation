# Connected App Consumer Key (no secret needed — PKCE public client, see design doc Section 8)
SF_CLIENT_ID=

# Base login URL for the org you're authenticating against.
# Production/Dev Edition: https://login.salesforce.com
# Sandbox:                https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# Must exactly match the Callback URL configured on the Connected App
SF_CALLBACK_URL=http://localhost:3000/oauth/callback

# Local service port
PORT=3000

# Session secret — local/dev only, nothing persisted between visits regardless
SESSION_SECRET=change-me-local-dev-only

# LLM-proposed test scenarios are additive — leave LLM_PROVIDER/LLM_API_KEY
# blank to run deterministic generation only (branch/loop/boundary coverage
# still runs regardless). Two providers implemented:
#
#   LLM_PROVIDER=anthropic
#     Paid, metered per token. LLM_API_KEY from https://console.anthropic.com
#     (API Keys section) — a claude.ai Pro/Max subscription does NOT work
#     here, that's a separate, non-programmatic product.
#     LLM_MODEL defaults to claude-opus-5 if unset.
#
#   LLM_PROVIDER=groq
#     Free tier, no card required. Good for proving this out before paying
#     for anything. LLM_API_KEY from https://console.groq.com (API Keys
#     section). LLM_MODEL defaults to openai/gpt-oss-120b if unset (a
#     genuinely open-weight, Apache-2.0-licensed reasoning model) — note
#     Groq's structured-output "json_schema" strict mode is known-unreliable
#     for this model, so the Groq provider uses the more broadly-supported
#     "json_object" mode instead (see providers/groqProvider.ts).
#
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Only used by the "anthropic" provider. One of: low, medium, high, xhigh, max. Defaults to medium.
LLM_EFFORT=

# Debug aid — set to false to watch the actual Playwright browser live
# during a test run instead of only reviewing screenshots afterward.
# Defaults to true (headless) otherwise.
PLAYWRIGHT_HEADLESS=true
